// Cloudflare Worker that serves the built Finance IQ site as static files.
// Cloudflare runs: build command `npm run build:pages`, then deploy command `npx wrangler deploy`.
// jeyinsights.com/financeiq/... reaches this Worker through the jeyinsights-proxy Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financeiq",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist-pages",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
