---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, absolute, url } from '../lib/site';
import { CURRENCY_KEY } from '../lib/money';

interface Props {
  title: string;
  description?: string;
  /** Path inside /financeiq/, for example "lab/savings-goal". Empty for the home page. */
  path?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description = SITE.description, path = '', ogType = 'website', noindex = false, jsonLd } = Astro.props;
const withSite = (t: string) => {
  for (const suffix of [` · ${SITE.name}`, ` · ${SITE.shortName}`]) if ((t + suffix).length <= 65) return t + suffix;
  return t;
};
const fullTitle = path === '' ? `${SITE.name}: Your money. Your move.` : withSite(title);
const canonical = absolute(path);
const ogImage = absolute(SITE.ogImage);
const themeKey = SITE.themeKey;
const currencyKey = CURRENCY_KEY;
const ld = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: absolute('') },
  author: { '@type': 'Person', name: SITE.author },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#6F907B" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('fonts/atkinson-next-latin-var.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/oswald-latin-var.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JeyInsights Finance IQ: Your money. Your move." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline define:vars={{ themeKey, currencyKey }}>
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem(themeKey); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
      try { var c = localStorage.getItem(currencyKey); if (c) document.documentElement.dataset.currency = c; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="fq-skip" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { getProgress } from '../lib/storage';
      // Show "Done" chips for items finished on this device.
      const done = new Set(getProgress().done);
      document.querySelectorAll<HTMLElement>('[data-done-for]').forEach((el) => { if (done.has(el.dataset.doneFor!)) el.hidden = false; });
    </script>
    <script>
      // Move focus to the page heading after moving between Finance IQ pages,
      // so screen reader users hear the new page name first.
      const h1 = document.querySelector<HTMLElement>('main h1');
      const fromInside = document.referrer.startsWith(`${location.origin}/financeiq/`);
      if (h1 && fromInside && !location.hash) {
        h1.setAttribute('tabindex', '-1');
        h1.focus({ preventScroll: true });
      }
    </script>
  </body>
</html>

<style is:global>
  .fq-skip {
    position: absolute; left: var(--ji-s-4); top: -100px; z-index: 100;
    background: var(--ji-primary); color: var(--ji-on-primary);
    padding: 10px 16px; border-radius: var(--ji-r-md); font-weight: 700; text-decoration: none;
  }
  .fq-skip:focus { top: var(--ji-s-3); }
</style>
